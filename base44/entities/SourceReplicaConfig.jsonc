{
  "name": "SourceReplicaConfig",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Project name (required)"
    },
    "database_root_name": {
      "type": "string",
      "description": "Database Root Name"
    },
    "replica_entity_name": {
      "type": "string",
      "description": "Replica entity name"
    },
    "source_entity_name": {
      "type": "string",
      "description": "Source entity name"
    },
    "sync_function_name": {
      "type": "string",
      "description": "Function: syncSourceEntityToSourceListener"
    },
    "push_function_name": {
      "type": "string",
      "description": "Function: pushtoReplicaEntityName"
    },
    "secret_name": {
      "type": "string",
      "description": "Replica App Set Secret Name"
    },
    "replica_app_id": {
      "type": "string",
      "description": "Replica App ID value"
    }
  },
  "required": [
    "project_name"
  ]
}