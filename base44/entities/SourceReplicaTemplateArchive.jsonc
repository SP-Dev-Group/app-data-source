{
  "name": "SourceReplicaTemplateArchive",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "The ID of the original SourceReplicaTemplateMakeReady record"
    },
    "project_name": {
      "type": "string",
      "description": "Project name at time of archival"
    },
    "version": {
      "type": "number",
      "description": "Version number at time of archival"
    },
    "snapshot": {
      "type": "string",
      "description": "JSON snapshot of the full template record at archival"
    }
  },
  "required": [
    "template_id",
    "project_name",
    "version"
  ]
}