{
  "name": "SourceReplicaTemplateStatus",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "Reference to the SourceReplicaTemplateMakeReady record ID"
    },
    "project_name": {
      "type": "string",
      "description": "Project name"
    },
    "confirmed_in_use": {
      "type": "boolean",
      "default": false,
      "description": "Whether the template has been confirmed as actioned and in use"
    },
    "confirmed_by": {
      "type": "string",
      "description": "Name/email of user who confirmed"
    },
    "confirmed_at": {
      "type": "string",
      "description": "ISO date when confirmed"
    },
    "withdrawn": {
      "type": "boolean",
      "default": false,
      "description": "Whether this template/project has been withdrawn"
    },
    "withdrawn_at": {
      "type": "string",
      "description": "ISO date when withdrawn"
    },
    "withdrawal_notes": {
      "type": "string",
      "description": "Notes about what was done during withdrawal"
    },
    "update_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the latest code update has been confirmed as applied to files"
    },
    "update_confirmed_at": {
      "type": "string",
      "description": "ISO date when update was confirmed"
    },
    "update_confirmed_by": {
      "type": "string",
      "description": "Name/email of user who confirmed the update"
    },
    "update_confirmed_version": {
      "type": "number",
      "description": "Version number that was confirmed as implemented"
    }
  },
  "required": [
    "template_id",
    "project_name"
  ]
}